# Copy to .env and fill in. Every variable below is read at startup; there are no
# silent defaults for model choice or reasoning effort — a missing value is a
# hard error rather than a different run than you intended.

# ── Endpoint for the OpenAI Agents SDK path (also used for embeddings) ──
# Default endpoint is OpenRouter; point REVIEW_API_BASE_URL anywhere
# OpenAI-compatible (https://api.openai.com/v1, a vLLM server, ...).
REVIEW_API_KEY=
REVIEW_API_BASE_URL=https://openrouter.ai/api/v1

# Embedding model used by the calibration RAG. Must be the same model the
# published embedding matrix was built with, or retrieval is meaningless.
REVIEW_EMBEDDING_MODEL=google/gemini-embedding-001

# Optional, OpenRouter only: pin the upstream provider so a run cannot silently
# switch backends mid-way. Leave empty for any other endpoint.
OPENROUTER_PROVIDER=

# ── Claude Agent SDK path ──
# Set to an Anthropic API key, or leave empty to use an authenticated
# Claude subscription (claude setup-token / claude login).
ANTHROPIC_API_KEY=

# ── PDF parsing (only needed when passing a .pdf) ──
DATALAB_API_KEY=
